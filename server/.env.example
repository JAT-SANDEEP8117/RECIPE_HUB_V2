PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/recipehub?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# Initial Administrator Credentials
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123

# SMTP Server Configurations (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM="RecipeHub Alerts" <noreply@recipehub.com>

# Groq Cloud API Credentials
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cloudinary Storage Configurations
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# URLs Configuration
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
